# 平台统一配置（模板 — 勿提交真实值；复制为 .env 后填入自己的密钥）
# 所有 BASE_URL/KEY 都是占位，指向你自己的 LLM / embedding 端点。

# ---- 主模型（OpenAI 兼容端点）----
PMLABS_BASE_URL=http://your-llm-host/v1
PMLABS_API_KEY=your-api-key
PMLABS_MODEL=your-model-name

# ---- embedding（语义检索；不填则 RED-KB 退化为关键词检索）----
EMBEDDING_URL=
EMBEDDING_KEY=
EMBEDDING_MODEL=bge-large-zh-v1.5

# ---- RED-KB ----
REDKB_URL=http://127.0.0.1:8001

# ---- 模型路由（PI 层统一控制；逗号分隔，首选挂掉自动降级）----
# MODEL_PRIORITY=your-model-name,backup-model
# MODEL_BASE_URL=http://your-llm-host/v1
# MODEL_AUTH_REF=PMLABS_API_KEY

# ---- 编排（可选，均有默认值）----
# PIMETA_MAX_MODULES=4          # 每次派发的攻击模块数
# PIMETA_TASK_BUDGET=7200       # 单任务硬预算（秒）
# PIMETA_KNOWN_FAST=1           # 已知靶场（有档案）自动走快通配方

# ---- Web UI 鉴权（对外部署时取消注释并填随机 token）----
# PIMETA_WEB_TOKEN=change-me-to-a-random-string
