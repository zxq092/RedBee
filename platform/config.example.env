# ============================================================================
# RedBee 平台统一配置（模板）
# 用法：cp config.example.env .env 后填入真实值。**.env 已被 .gitignore，不会入库/入镜像。**
# 运行时经 compose 的 env_file 注入；改 .env 后多数参数热加载生效（见"热加载"节）。
# ============================================================================

# ============ 1. LLM 主模型（OpenAI 兼容端点，必填）============
MODEL_PRIORITY=your-model-name,backup-model        # 逗号分隔；首选挂掉自动降级
PMLABS_BASE_URL=http://your-llm-host/v1            # 兼容旧命名；等价 MODEL_BASE_URL
PMLABS_API_KEY=your-api-key                        # 模型 key（MODEL_AUTH_REF 指向的变量）
PMLABS_MODEL=your-model-name
OPEN_AI_SERVER_URL=http://your-llm-host/v1         # 引擎直读的 OpenAI 兼容端点
OPEN_AI_KEY=your-api-key

# 模型超时（毫秒级语义见下；非流式聚合场景下 read 必须覆盖整段生成）
MODEL_TIMEOUT=120
MODEL_READ_TIMEOUT=30
MODEL_PROFILE_JSON=                                # 备用模型端点档案（JSON，可选）

# ============ 2. embedding（语义检索；不填则 RED-KB 退化为关键词检索）============
EMBEDDING_URL=
EMBEDDING_KEY=
EMBEDDING_MODEL=bge-large-zh-v1.5

# ============ 3. RED-KB 知识库 ============
REDKB_URL=http://127.0.0.1:8001                    # 网关访问 RED-KB；compose 内用 http://redkb:8001
REDKB_DATA_DIR=                                    # 默认 <项目>/data；DB/靶场档案所在
REDKB_ADMIN_TOKEN=                                 # 知识库治理管理 token（可选）

# ============ 4. 编排（外层，默认值即可）============
PIMETA_MAX_MODULES=4                               # 每次派发候选攻击模块数
PIMETA_TASK_BUDGET=7200                            # 单任务硬预算（秒），防无限跑
PIMETA_MAX_PARALLEL=2                              # 单任务内并行子 agent 数
PIMETA_GLOBAL_MAX_LLM_CONCURRENCY=4                # 全平台在飞 LLM 请求数上限（治并发超时）
PIMETA_DATA_DIR=                                   # 默认 <项目>/data；DB 路径
PIMETA_DB=                                         # 默认 <项目>/data/pimeta.db

# ============ 5. 引擎（HINSE_*，均有默认）============
# HINSE_MAX_PARALLEL=3          # 并行子 agent（与 PIMETA_MAX_PARALLEL 联动）
# HINSE_CHILD_MAX_TURNS=40      # 单子 agent LLM 轮次上限
# HINSE_MAX_TURNS=              # 引擎总轮次上限
# HINSE_TASK_BUDGET=            # 引擎级任务预算（秒）
# HINSE_TOOL_TIMEOUT=120        # 单次工具调用硬超时（秒）
# HINSE_TOOL_OUT_CHARS=8000     # 工具输出截断字符
# HINSE_CONTEXT_BUDGET=80000    # 上下文总预算（触发压缩）
# HINSE_SKILL_MAX_CHARS=8000    # 单个 skill 注入截断
# HINSE_SKIP_RECON=0            # 热启动跳侦察（已知靶场自动开）
# HINSE_FORCE_ALL_MODULES=0     # 不做 LLM 剪枝全派候选（已知靶场自动开）
# HINSE_DOCKER_IMAGE=vxcontrol/kali-linux:latest   # 沙箱镜像
# HINSE_DELIVERABLES=           # 交付物目录（相位间情报）

# ============ 6. 已知靶场快通配方（PIMETA_KNOWN_*；有靶场档案自动套用）============
PIMETA_KNOWN_FAST=1                                # 已知靶场自动走快通
PIMETA_KNOWN_MAX_MODULES=9
PIMETA_KNOWN_MAX_PARALLEL=2
PIMETA_KNOWN_CHILD_TURNS=80
PIMETA_KNOWN_TASK_SUFFIX=KNOWN TARGET: produce one clean PoC per module, then move on.

# ============ 7. Web UI 鉴权（对外部署时必设）============
# 设了 token 后：所有写操作(派发/停止/删除/重命名)需先 /api/login 换 session_token，
# 读接口(会话/漏洞板/报告)保持开放；网关建议绑 0.0.0.0。
PIMETA_WEB_TOKEN=change-me-to-a-random-string
# PIMETA_WEB_SESSION_TTL=12        # 会话 token 有效期（小时）
# PIMETA_WEB_SESSION_SALT=        # 会话 token 签名盐（随机串）

# ============ 8. PentAGI 回流（可选，未配置自动跳过；仅供对接旧 PentAGI 数据）============
# PENTAGI_URL=
# PENTAGI_TOKEN=

# ============================================================================
# 热加载说明：以上 HINSE_*/PIMETA_*/MODEL_* 均每次读取 .env（改后即时生效，无需重启）。
# 需重启才能生效的仅：EMBEDDING_*、REDKB_*、PIMETA_WEB_TOKEN、PIMETA_DB 等顶层常量
# （以及换 .env 里的 key）。
# ============================================================================
