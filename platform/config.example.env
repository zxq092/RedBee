# ===================== RedBee / PI Meta Gateway — Example Configuration =====================
# Copy to .env and fill in:   cp config.example.env .env
#
# SECURITY: .env contains API keys and must NEVER be committed to git.
#   - It is already excluded in .gitignore.
#   - Never put real keys into config.example.env.

# --- 1. LLM model routing (OpenAI-compatible) --------------------------------------------
# Required. Comma-separated, ordered fallback queue:
#   MODEL_PRIORITY=model_name_1,model_name_2
# Endpoint + key for the primary model:
MODEL_BASE_URL=http://YOUR-LGATEWAY/v1
MODEL_KEY=sk-YOUR-KEY-HERE
# Comma-separated model names in priority order (first = primary, rest = fallback):
MODEL_PRIORITY=your-model-a,your-model-b
# Per-call timeout (seconds). Keep it >= your longest expected generation:
MODEL_TIMEOUT=180
MODEL_READ_TIMEOUT=180

# --- 2. Knowledge base (RED-KB) -----------------------------------------------------------
# Hosted mode (default): the gateway uses an external RED-KB service.
REDKB_MODE=hosted
REDKB_URL=http://127.0.0.1:8001
# Built-in mode (embed a local SQLite KB into the gateway): set REDKB_MODE=embedded
# and configure the DB path (and optionally the embedding endpoint) below.
#REDKB_MODE=embedded
#REDKB_EMBEDDING_URL=http://YOUR-EMBEDDING/v1
#REDKB_EMBEDDING_MODEL=bge-large-zh-v1.5
#REDKB_EMBEDDING_KEY=YOUR-EMBEDDING-KEY
#REDKB_EMBEDDING_DIM=1024

# --- 3. Pentest sandbox (Kali container image) --------------------------------------------
# Image the gateway uses to spawn isolated pentest sandboxes.
# Build it once on the host (see README "Build the sandbox image"), or point at
# any Kali image you already have:
HINSE_DOCKER_IMAGE=redbee-kali:local

# --- 4. Task / budget limits (seconds) -----------------------------------------------------
PIMETA_TASK_BUDGET=3600        # hard per-task wall-clock budget (governor)
HINSE_TASK_BUDGET=1800         # in-house agent task budget
HINSE_TOOL_TIMEOUT=120         # per-tool-call timeout
# Global LLM concurrency gate — protects a single LLM endpoint from being overwhelmed
# by parallel large-context requests (the usual cause of hung/dead LLM calls):
PIMETA_GLOBAL_MAX_LLM_CONCURRENCY=4
# Cooldown before auto-retrying a module whose exploit agent died from a dead LLM
# (seconds; 0 disables retry):
HINSE_MODULE_RETRY_DELAY=60

# --- 5. Context / prompt engineering -------------------------------------------------------
HINSE_SKILL_MAX_CHARS=8000     # max chars of an injected skill (context cap)
HINSE_TOOL_OUT_CHARS=8000      # max chars of a single tool output fed back to the LLM
HINSE_CONTEXT_BUDGET=80000     # total message budget before compaction kicks in

# --- 6. Known-target fast-clear (auto-recipe for already-profiled ranges) -------------------
# When a target has a profile in data/targets/<id>.md, the platform can skip recon and
# fan out all modules with tuned parallelism. Leave the defaults below as-is unless
# you have a specific reason to tune.
# PIMETA_KNOWN_FAST=1
# PIMETA_KNOWN_MAX_MODULES=9
# PIMETA_KNOWN_MAX_PARALLEL=4
# PIMETA_KNOWN_CHILD_TURNS=80
# PIMETA_KNOWN_TASK_SUFFIX=

# --- 7. Target registry (stable id -> address, for KB lookups & profiles) -------------------
# Map well-known lab addresses to stable ids. The KEY is the stable target_id used by
# the knowledge base and data/targets/<id>.md profiles; the VALUE is the address that
# resolves to that target in YOUR environment (docker networks change IPs on restart).
# Replace with your own lab addresses, or leave empty if you always pass target_id explicitly:
PIMETA_TARGET_ID_MAP=

# --- 8. Web console --------------------------------------------------------------------------
# Bearer token protecting the web UI / API (set a strong value in production):
PIMETA_WEB_TOKEN=change-me
# Host the gateway binds to:
PIMETA_HOST=0.0.0.0
# Port the gateway listens on:
PIMETA_PORT=8000
